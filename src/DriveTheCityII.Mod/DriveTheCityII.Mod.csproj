<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The native Cities: Skylines II code mod (ADR-0005). The game loads it from
    <user data>\Mods\DriveTheCityII\ (CSII_LOCALMODSPATH). It targets .NET Framework 4.8 like the game's Mono
    profile; the reference assemblies come from the Microsoft.NETFramework.ReferenceAssemblies package that the SDK
    adds automatically. Game assemblies are referenced from the installed game and are never copied or shipped.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DriveTheCityII</AssemblyName>
    <RootNamespace>DriveTheCityII</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <!-- Keep AssemblyVersion fixed: the game identifies serialized mod types by assembly-qualified name
         (refcache note 01, section 5.3). The real version is in the informational version. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(DtcVersion).0</FileVersion>
    <InformationalVersion>$(DtcVersion)</InformationalVersion>
    <DtcBuildStamp Condition="'$(DtcBuildStamp)' == ''">dev</DtcBuildStamp>
    <Cs2ManagedPath Condition="'$(Cs2ManagedPath)' == '' and '$(CSII_MANAGEDPATH)' != ''">$(CSII_MANAGEDPATH)</Cs2ManagedPath>
    <Cs2ManagedPath Condition="'$(Cs2ManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</Cs2ManagedPath>
    <!-- Compile against the game's own Mono class libraries (as the official toolchain does with CSII_MSCORLIBPATH),
         not the .NET Framework reference assemblies, so that APIs such as Span match the real runtime. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <FrameworkPathOverride>$(Cs2ManagedPath)</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DtcBuildStamp" Value="$(DtcBuildStamp)" />
  </ItemGroup>

  <!-- Core logic compiled into the single mod assembly. -->
  <ItemGroup>
    <Compile Include="..\DriveTheCityII.Core\**\*.cs" LinkBase="Core" />
    <!-- TEMPORARY while Core/Career is being written in parallel; re-enabled at integration. -->
    <Compile Remove="..\DriveTheCityII.Core\Career\**" />
    <Compile Remove="Careers\**" />
  </ItemGroup>

  <ItemGroup>
    <Cs2Ref Include="mscorlib;System;System.Core;netstandard;System.Runtime;System.Xml;System.Numerics;Game;Colossal.Core;Colossal.AssetPipeline;Colossal.Collections;Colossal.Mathematics;Colossal.Logging;Colossal.IO.AssetDatabase;Colossal.Localization;Colossal.UI;Colossal.UI.Binding;Colossal.PSI.Common;Unity.Collections;Unity.Entities;Unity.Mathematics;Unity.Burst;Unity.InputSystem;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.InputLegacyModule;UnityEngine.ScreenCaptureModule;UnityEngine.ImageConversionModule;UnityEngine.TextRenderingModule;UnityEngine.AnimationModule;Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.HighDefinition.Runtime;Cinemachine;System.Memory" />
    <Reference Include="@(Cs2Ref)">
      <HintPath>$(Cs2ManagedPath)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="UI\DriveTheCityII.mjs" CopyToOutputDirectory="PreserveNewest" Link="DriveTheCityII.mjs" />
  </ItemGroup>

  <Target Name="DtcCheckManagedPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Cs2ManagedPath)\Game.dll')" Text="Cities: Skylines II managed assemblies not found at '$(Cs2ManagedPath)'. Set Cs2ManagedPath or CSII_MANAGEDPATH." />
  </Target>
</Project>
